# Copy to .env (or set these in your host's dashboard). Never commit real keys.
STRIPE_SECRET_KEY=sk_test_...          # Stripe dashboard → Developers → API keys
SESSION_SECRET=                        # 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BASE_URL=https://your-domain.example   # public address of the site, no trailing slash
# Optional
TRIAL_DAYS=7                           # free trial length; 0 turns the trial off
MONTHLY_PRICE_PENCE=500                # £5.00 a month
YEARLY_PRICE_PENCE=5000                # £50.00 a year
STRIPE_TAX=0                           # set to 1 to enable Stripe Tax (UK VAT) – needs setup in Stripe
RESEND_API_KEY=                        # sends sign-in emails; empty = link is printed to the server log (dev only)
EMAIL_FROM=Excel Easy <login@your-domain.example>
PORT=3000
